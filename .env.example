# Copy to .env and adjust. .env is ignored by git: never commit it.
# Every setting is optional; the defaults run the default profile on a local LM Studio.

# A shipped profile name (default: qwen3.5-9b) or the path to a profile file.
# The profile sets the backend: qwen3.5-9b runs on LM Studio, qwen3.5-9b-openrouter on OpenRouter.
# Team rule: never send Retriever data to OpenRouter.
# KARAAGE_PROFILE=

# Defaults: http://127.0.0.1:1234/v1 for LM Studio, https://openrouter.ai/api/v1 for OpenRouter
# KARAAGE_BASE_URL=

# Required for profiles on OpenRouter or another OpenAI-compatible server
# KARAAGE_API_KEY=
