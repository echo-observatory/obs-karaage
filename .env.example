# Copy to .env and adjust. .env is ignored by git: never commit it.
# Every setting is optional; the defaults run the default profile on a local LM Studio.

# lmstudio (default), openrouter, or openai (any other OpenAI-compatible server)
# KARAAGE_BACKEND=lmstudio

# Defaults: http://127.0.0.1:1234/v1 for lmstudio, https://openrouter.ai/api/v1 for openrouter
# KARAAGE_BASE_URL=

# Required for openrouter and openai. Team rule: never send Retriever data to OpenRouter.
# KARAAGE_API_KEY=

# A shipped profile name (default: qwen3.5-9b) or the path to a profile file
# KARAAGE_PROFILE=
